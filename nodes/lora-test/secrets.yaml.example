# Kopieren nach secrets.yaml und ausfüllen (secrets.yaml ist in .gitignore)
wifi_ssid: "DEIN_WLAN"
wifi_password: "DEIN_PASSWORT"
ota_password: "OTA_PASSWORT"

# API-Keys: im ESPHome Dashboard generieren oder `openssl rand -base64 32`
api_key_sender: "BASE64_KEY_32_BYTES="
api_key_receiver: "BASE64_KEY_32_BYTES="

# Gemeinsamer Schlüssel für die LoRa-Verschlüsselung (Sender = Empfänger)
lora_key: "BELIEBIGER_LANGER_STRING"
